# Docker ignore file for Java Maven projects
# Excludes unnecessary files from Docker build context

# Maven build outputs
target/
!target/*.jar

# Maven wrapper (CRITICAL: Never use wrapper in Docker)
mvnw
mvnw.cmd
.mvn/

# Gradle wrapper (if present)
gradlew
gradlew.bat
gradle/wrapper/

# IDE files
.idea/
.vscode/
.settings/
.classpath
.project
*.iml
*.iws
*.ipr

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
docs/

# Logs
logs/
*.log

# Test files
src/test/

# CI/CD
.github/
.gitlab-ci.yml
Jenkinsfile

# Docker files (don't copy into image)
Dockerfile*
docker-compose*.yml
.dockerignore

# Environment files
.env
.env.*

# Temporary files
*.tmp
*.bak
*.swp
*~
