# =============================================================================
# .dockerignore — ResortsLite Spring Boot Application
# Excludes files that should NOT be sent to the Docker build context
# =============================================================================

# Build output
target/

# Maven wrapper files (MUST be excluded — Docker build uses system mvn)
mvnw
mvnw.cmd
.mvn/

# Gradle wrapper files (not used, but exclude for safety)
gradlew
gradlew.bat
gradle/
gradle/wrapper/

# Version control
.git/
.gitignore
.gitattributes

# IDE and editor files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
*.swp
*.swo

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# Documentation
*.md
docs/

# Test reports and coverage
**/surefire-reports/
**/failsafe-reports/
**/jacoco/

# Logs
*.log
logs/

# Containerization artifacts (not needed inside image)
Dockerfile*
docker-compose*.yml
.dockerignore

# Scripts
scripts/

# ECS manifests
ecs/

# Temporary files
*.tmp
*.bak
*.orig
