{
  "family": "resortsLite-task",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "resortsLite",
      "image": "{{IMAGE_URI}}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE",          "value": "docker" },
        { "name": "TZ",                               "value": "UTC" },
        { "name": "JAVA_OPTS",                        "value": "-Xmx512m -Xms256m -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom" },
        { "name": "PAYMENT_SERVICE_ENDPOINT",         "value": "http://payment-service:9090" },
        { "name": "INVENTORY_SERVICE_ENDPOINT",       "value": "http://inventory-service:8081" },
        { "name": "DB_HOST",                          "value": "db-service" },
        { "name": "APP_REPORT_BASE_PATH",             "value": "/mnt/efs/reports" },
        { "name": "APP_BACKUP_PATH",                  "value": "/mnt/efs/backups" },
        { "name": "CACHE_TTL_SECONDS",                "value": "3600" },
        { "name": "ALB_STICKINESS_ENABLED",           "value": "true" },
        { "name": "ALB_STICKINESS_DURATION_SECONDS",  "value": "86400" }
      ],
      "secrets": [
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:{{AWS_REGION}}:{{ACCOUNT_ID}}:secret:resortsLite/jwt-secret"
        },
        {
          "name": "MEMCACHED_ENDPOINT",
          "valueFrom": "arn:aws:ssm:{{AWS_REGION}}:{{ACCOUNT_ID}}:parameter/resortsLite/cache/endpoint"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/resortsLite",
          "awslogs-region": "{{AWS_REGION}}",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "mountPoints": [
        {
          "sourceVolume": "efs-reports",
          "containerPath": "/mnt/efs/reports",
          "readOnly": false
        },
        {
          "sourceVolume": "efs-backups",
          "containerPath": "/mnt/efs/backups",
          "readOnly": false
        }
      ]
    }
  ],
  "volumes": [
    {
      "name": "efs-reports",
      "efsVolumeConfiguration": {
        "fileSystemId": "{{EFS_FILE_SYSTEM_ID}}",
        "rootDirectory": "/reports",
        "transitEncryption": "ENABLED"
      }
    },
    {
      "name": "efs-backups",
      "efsVolumeConfiguration": {
        "fileSystemId": "{{EFS_FILE_SYSTEM_ID}}",
        "rootDirectory": "/backups",
        "transitEncryption": "ENABLED"
      }
    }
  ]
}
