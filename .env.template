# ResortsLite PostgreSQL Environment Variables Template
# Copy this file to .env and update with your actual values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resortdb
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_SSL_MODE=prefer

# Connection Pool Settings
DB_POOL_MAX=20
DB_POOL_MIN=5

# Application Settings
PORT=8080
SPRING_PROFILES_ACTIVE=postgresql

# Hibernate Settings
DDL_AUTO=validate
INIT_MODE=never
SHOW_SQL=false

# Logging Levels
LOG_SQL=INFO
LOG_PARAMS=INFO
LOG_JDBC=INFO
LOG_APP=INFO

# External Service Endpoints (use HTTPS in production)
PAYMENT_ENDPOINT=https://payment-svc.internal:9090/charge
INVENTORY_ENDPOINT=https://inventory-svc.internal:8081/rooms
NOTIFICATION_ENDPOINT=https://notify.internal:7070/send

# File Storage Paths (use cloud storage in production)
REPORT_PATH=/tmp/reports/
BACKUP_PATH=/tmp/backups/

# Report Service Configuration
REPORT_DOMAIN=reports.resorts-internal.com

# AWS Configuration (for production deployment)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_RDS_ENDPOINT=your-rds-instance.region.rds.amazonaws.com

# Security Configuration (for production)
# JWT_SECRET=your_jwt_secret_key
# JWT_EXPIRATION=86400000
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
